# Keycloak for AutoWorkshop, deployable to Render.
#
# ── 🔴 SOLAR'S OOM CYCLE IS THE REASON THIS FILE LOOKS LIKE THIS ────────────
#
# SolarPro ran Keycloak on Render's free 512 MiB plan and took **7 OOM kills in
# 5 days, every one at COLD START**, on roughly 75 real requests per 12 hours —
# not load, just booting. The settings that eventually stopped it are applied
# HERE FROM THE FIRST BOOT rather than discovered again:
#
#   * `kc.sh build` at IMAGE BUILD time, so the container starts an already
#     optimised distribution (~3-5s) instead of rebuilding on every boot (~30s).
#     Cold-start time, not heap headroom, was the binding constraint: Solar's
#     first fix attempt pushed boot to ~125s, blew Render's health-check window,
#     and left a deploy stuck at `update_in_progress` — which then BLOCKED every
#     later deploy.
#   * `KC_CACHE=local`. Infinispan clustering is pointless on a single node and
#     cost Solar ~80 MB and ~30s of startup.
#   * A heap cap with `ExitOnOutOfMemoryError`. Without a cap the JVM sizes
#     itself against the HOST's memory, not the container's limit, so the
#     cold-start spike tips a 512 MiB box into an OS-level kill. Exiting on OOM
#     is deliberate: a JVM limping along after an OOM is worse than a restart,
#     because Render will replace a dead container and cannot fix a sick one.
#
# ⚠️ Render's free 512 MiB remains genuinely undersized for Keycloak. These
# settings are what made it survivable for Solar, not a guarantee. If it OOMs
# here too, the honest answer is more memory — which is a SPEND decision and
# the owner's alone.
#
# ADR-011: Solar is the reference implementation. Nothing is imported from it;
# this is a separate image, realm, database and deployment (D2a).

# Pinned, not floating: an IdP that silently takes a major version on a rebuild
# is a way to lose every session in production without a commit to blame.
FROM quay.io/keycloak/keycloak:26.0 AS builder

# These are read by `kc.sh build` and baked into the distribution. They are set
# again at runtime because build-stage ENV does not survive into the final image.
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_CACHE=local \
    KC_HTTP_RELATIVE_PATH=/

RUN /opt/keycloak/bin/kc.sh build

# ── runtime ────────────────────────────────────────────────────────────────
FROM quay.io/keycloak/keycloak:26.0

COPY --from=builder /opt/keycloak/ /opt/keycloak/

# 🔴 THE PRODUCTION REALM, NOT THE DEVELOPMENT ONE. `realm-prod.json` is
# generated by `build-prod-realm.mjs`, which strips the nine `localhost` and
# `exp://` redirect URIs the dev realm carries and REFUSES to emit a realm that
# still has one, or that carries a user. Copying `realm-autoworkshop.json`
# directly here would ship a public client that accepts an authorization code
# at the victim's own machine.
COPY infrastructure/keycloak/render/realm-prod.json /opt/keycloak/data/import/realm-prod.json

# `--import-realm` reads this directory on FIRST BOOT ONLY; later boots find the
# realm in the database and skip it. Editing the realm afterwards is a kcadm
# job, not a redeploy.
ENV KC_DB=postgres \
    KC_CACHE=local \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_HTTP_ENABLED=true \
    KC_PROXY_HEADERS=xforwarded \
    KC_HOSTNAME_STRICT=false \
    # 🔴 `-XX:-UseG1GC` IS LOAD-BEARING AND MUST STAY IN FRONT OF `+UseSerialGC`.
    #
    # This line previously read `... -XX:+UseSerialGC` with no `-XX:-UseG1GC`,
    # and THE JVM REFUSED TO START AT ALL:
    #
    #     Error occurred during initialization of VM
    #     Multiple garbage collectors selected
    #
    # Keycloak's own entrypoint already puts `-XX:+UseG1GC` in JAVA_OPTS, and
    # JAVA_OPTS_APPEND is APPENDED to it — so asking for Serial as well asks for
    # two collectors, which is fatal rather than "last one wins". Keycloak would
    # never have booted on Render; it was not an OOM risk, it was a dead
    # container on every single start.
    #
    # Caught by the deploy workflow's own "prove the image is a real, optimised
    # Keycloak" step the first time that workflow was ever run — which is the
    # whole argument for a step that RUNS the artifact instead of trusting that
    # it built. Reproduced locally, then verified by reading the flags back:
    # `UseG1GC = false, UseSerialGC = true`, both `{command line}`.
    #
    # Serial is kept rather than simply dropped: on a 512 MiB box it has a
    # materially smaller footprint than G1, which is the constraint that made
    # Solar's Keycloak OOM seven times in five days.
    JAVA_OPTS_APPEND="-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError -XX:-UseG1GC -XX:+UseSerialGC"

EXPOSE 10000

# Shell form so `$PORT` expands — Render assigns it and JSON-form CMD does not
# substitute. `exec` replaces the shell so SIGTERM on redeploy reaches Keycloak
# and it shuts down cleanly instead of being killed.
ENTRYPOINT []
CMD ["sh", "-c", "exec /opt/keycloak/bin/kc.sh start --optimized --import-realm --http-port=${PORT:-10000}"]
