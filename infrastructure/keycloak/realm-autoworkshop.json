{
  "realm": "autoworkshop",
  "displayName": "AutoWorkshop AI",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and passwordHistory(3)",
  "roles": {
    "realm": [
      {
        "name": "vehicle_owner",
        "description": "Customer — owns vehicles, submits complaints, approves proposals"
      },
      {
        "name": "driver",
        "description": "Drives a fleet vehicle; may report faults"
      },
      {
        "name": "workshop_owner",
        "description": "Owns a workshop organization"
      },
      {
        "name": "workshop_administrator",
        "description": "Administers a workshop organization"
      },
      {
        "name": "service_adviser",
        "description": "Receives customers, creates job cards, presents proposals"
      },
      {
        "name": "lead_technician",
        "description": "Senior technician; may authorise diagnostic dismantling"
      },
      {
        "name": "mechanic",
        "description": "General mechanical repair"
      },
      {
        "name": "auto_electrician",
        "description": "Auto electrical diagnosis and repair"
      },
      {
        "name": "electronics_technician",
        "description": "ECU, networks, coding and calibration"
      },
      {
        "name": "body_technician",
        "description": "Bodywork and panel repair"
      },
      {
        "name": "welder",
        "description": "Welding; structural work requires qualification"
      },
      {
        "name": "spray_painter",
        "description": "Preparation, paint and finishing"
      },
      {
        "name": "upholsterer",
        "description": "Interior trim and upholstery"
      },
      {
        "name": "vulcanizer",
        "description": "Tyres, puncture repair, balancing, alignment"
      },
      {
        "name": "storekeeper",
        "description": "Parts depot — receipt, issue, return"
      },
      {
        "name": "procurement_officer",
        "description": "Requisitions, purchase orders, supplier orders"
      },
      {
        "name": "quality_inspector",
        "description": "Independent quality control before release"
      },
      {
        "name": "supplier_owner",
        "description": "Owns a supplier organization"
      },
      {
        "name": "supplier_staff",
        "description": "Manages products and orders for a supplier"
      },
      {
        "name": "fleet_administrator",
        "description": "Administers a fleet organization"
      },
      {
        "name": "fleet_approver",
        "description": "Approves fleet repair proposals within thresholds"
      },
      {
        "name": "insurance_assessor",
        "description": "Assesses damage and reviews estimates"
      },
      {
        "name": "claims_approver",
        "description": "Approves claims and repair authorisation"
      },
      {
        "name": "towing_dispatcher",
        "description": "Dispatches recovery jobs"
      },
      {
        "name": "towing_driver",
        "description": "Performs recovery; captures proof of collection/delivery"
      },
      {
        "name": "training_instructor",
        "description": "Authors courses, marks assessments"
      },
      {
        "name": "platform_support_agent",
        "description": "Support cases; no cross-tenant data access by default"
      },
      {
        "name": "security_analyst",
        "description": "Security events and investigation"
      },
      {
        "name": "platform_administrator",
        "description": "Platform administration — cross-tenant, always audited"
      },
      {
        "name": "mcp_administrator",
        "description": "MCP server registry, tool enablement, kill switch"
      }
    ]
  },
  "clients": [
    {
      "clientId": "autoworkshop-customer-web",
      "name": "Customer web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "https://autoworkshop.aiappinvent.com/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://autoworkshop.aiappinvent.com"
      ],
      "protocolMappers": [
        {
          "name": "autoworkshop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "autoworkshop-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
