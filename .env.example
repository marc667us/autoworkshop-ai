# Copy to .env for local development. NEVER commit .env (ci.yml fails the build).
NODE_ENV=development

# ── Database (self-hosted; D6 zero-cost) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autoworkshop
POSTGRES_USER=autoworkshop
POSTGRES_PASSWORD=change_me_locally
# POSTGRES_USER above is the BOOTSTRAP SUPERUSER — used by migrations and the
# backup scripts, and by nothing else. The API connects as `autoworkshop_app`
# (NOSUPERUSER, NOBYPASSRLS, created by migration 002) because **a superuser
# bypasses row-level security entirely, even with FORCE**. `DatabaseService`
# refuses to start on a DATABASE_URL naming the superuser, so this is not
# advisory: point it at the app role or the API will not boot.
DATABASE_URL=postgresql://autoworkshop_app:change_me_locally@localhost:5432/autoworkshop

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── NATS (domain events; ADR-014) ───────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Object storage (MinIO, S3-compatible) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_locally
S3_BUCKET=aw-media

# ── Keycloak (own realm — D2a: never Solar's) ───────────────────────────────
# These two are read by BOTH halves and must agree: the API validates the `iss`
# claim against `${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}`, and the web apps
# derive the same issuer. A mismatch shows up as "token rejected: jwt issuer
# invalid", which reads like a signing fault and is a configuration one.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=autoworkshop
# The audience the API requires. Supplied to browser tokens by the
# `autoworkshop-audience` client scope, attached to all seven web clients by
# `infrastructure/keycloak/import-realm.sh`.
KEYCLOAK_AUDIENCE=autoworkshop-api
# NOTE: there is deliberately no KEYCLOAK_CLIENT_ID. Each web app authenticates
# as its OWN public client, `autoworkshop-<workspace>-web`, derived from the
# workspace id in `@autoworkshop/auth`. A single shared id was stale here for
# some time — `autoworkshop-web` matches no client in the realm.

# ── Web-app sessions (Auth.js v5 — D6 zero-cost, MIT) ───────────────────────
# Encrypts the session cookie (JWE). REQUIRED TO SERVE A PAGE AT ALL, not just
# to sign in: every app runs `auth` as middleware on every request, and the
# config resolves this when it is built. Absent, the apps 500 on every route.
# Generate one per environment: `openssl rand -base64 32`.
# All seven apps may share one value locally; they are separate origins with
# separate cookies.
AUTH_SECRET=change_me_locally_generate_with_openssl_rand_base64_32
# Where the Next servers reach the API for `GET /api/v1/me`. Server-to-server —
# the browser never calls the API directly and never receives an access token.
API_BASE_URL=http://localhost:4000

# ── LLM (local Ollama; zero-cost default) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# NOTE: per-tenant provider credentials (payments, SMTP, SMS, model API keys)
# are NEVER set here. They are bring-your-own-connection (D7), stored encrypted
# per tenant in the database, configured by each tenant in app settings.
