{
  "expo": {
    "name": "AutoWorkshop",
    "slug": "autoworkshop",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "autoworkshop",
    "android": {
      "package": "com.aiappinvent.autoworkshop",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiappinvent.autoworkshop"
    },
    "plugins": ["expo-secure-store"],
    "extra": {
      "keycloakUrl": "http://10.0.2.2:8080",
      "keycloakRealm": "autoworkshop",
      "apiBaseUrl": "http://10.0.2.2:4000"
    }
  }
}
