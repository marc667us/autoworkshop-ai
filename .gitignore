# ── Sensitive ───────────────────────────────────────────────────────────────
# Never commit secrets. Solar leaked secrets for 35 days (2026-07-10) because a
# ciphertext store was committed and the key later leaked. Ciphertext + leaked
# key is still a breach. Keep both out of git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
.secrets/

# Per-tenant provider credentials (D7 bring-your-own-connection) are stored
# encrypted in the database, never on disk, never in git.

# ── Node / TypeScript ───────────────────────────────────────────────────────
node_modules/
.pnpm-store/
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
coverage/
.eslintcache

# ── Python (ADK agent host) ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Databases / dumps ───────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sql.gz
*.dump
backups/

# ── Media / uploads (never committed; object storage only) ──────────────────
uploads/
media/
quarantine/

# ── Test artefacts ──────────────────────────────────────────────────────────
playwright-report/
test-results/
storybook-static/
*-snapshots/__diff_output__/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
tunnel_*.log

# ── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.tmp
*.bak
*.bak_*
Thumbs.db
.DS_Store

# ── Backup artefacts and the backup encryption key ──────────────────────────
# `.backup-key` does NOT match the `*.key` rule above (it ends in "-key", not
# ".key"). Solar leaked secrets for 35 days in 2026-07; this is the same class
# of mistake, one commit away.
infrastructure/backup/.backup-key
infrastructure/backup/.backup-s3-secret
infrastructure/backup/artifacts/
infrastructure/backup/logs/
infrastructure/backup/status/

# Guardrail runtime state: retrieval index, context packs, raw reviewer output.
# Generated evidence, not source - and the raw transcripts are large.
.guardrails/

# Seam file for the sign-out revocation proof (contains a real dev session)
# Captured sign-in sessions used by the verify/ probes. These are REAL CREDENTIALS —
# an encrypted Auth.js session cookie plus a live Keycloak access token.
#
# ⚠️ A GLOB, NOT ONE FILENAME. `capture-session.mjs --out` (slice 3b) can write any
# name, because proving §1292's reviewer independence needs two sessions alive at
# once — and `.verify-tech-cookies.json` / `.verify-sup-cookies.json` were staged by
# `git add -A` on the very first run, since the old exact-match line did not cover
# them. One filename in an ignore file is a rule that holds only until somebody adds
# a second file.
.verify-*cookies*.json
.verify-session-cookies.json

# Backup-drill runtime lock — holds a live PID and timestamp, so it is machine
# state, never source. Swept into a commit once by a `git add -A`.
infrastructure/backup/.lock-*/
