# Agent host configuration — copy to .env and fill in.
#
# 🔴 NEVER COMMIT A REAL VALUE. This repository is public and gitleaks scans
# history on every push. Every value below is blank or a safe default on
# purpose; a key committed once is compromised for good.

# --- Auth -------------------------------------------------------------------
# Shared secret every caller must present as `Authorization: Bearer <token>`.
# ⚠️ EMPTY MEANS EVERY ROUTE IS REFUSED. That is the fail-closed default, not a
# development convenience.
AGENT_HOST_TOKEN=

# --- Local model (zero cost, the default) -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
# Bounded. On timeout triage degrades to deterministic rules rather than
# failing. Measured: llama3.2 on CPU needs ~150s for a full triage, so the
# model path will not engage at 60s on modest hardware — by design.
LLM_TIMEOUT_SECONDS=60

# --- Extraction backend (ADR-015, bring-your-own-connection) -----------------
# OPTIONAL. Leave BLANK for the local Ollama backend, which is the supported
# default and costs nothing (ADR-012). Setting it opts in to ScrapeGraph's
# hosted API, which bills credits — the owner's decision alone.
SCRAPEGRAPH_API_KEY=

# --- Scraping safety --------------------------------------------------------
# Comma-separated hostnames. An entry may be an exact host
# ("parts.example.com") or a dot-prefixed suffix (".example.com") matching that
# domain and its subdomains.
# ⚠️ EMPTY MEANS NO PAGE MAY BE FETCHED AT ALL. Fail closed.
SCRAPE_ALLOWLIST=
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_MAX_BYTES=2000000
SCRAPE_MIN_INTERVAL_SECONDS=2.0
SCRAPE_RESPECT_ROBOTS=true
